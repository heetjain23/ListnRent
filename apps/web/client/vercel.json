{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then export VITE_SITE_MODE=production; elif [ \"$VERCEL_ENV\" = \"preview\" ]; then export VITE_SITE_MODE=preview; else export VITE_SITE_MODE=development; fi; npm run build",
  "headers": [
    {
      "source": "/(login|dashboard|checkout|create|edit|order|rental|complete-magic-link)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
