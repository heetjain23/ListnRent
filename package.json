{
  "name": "listnrent-monorepo",
  "version": "1.0.0",
  "description": "ListnRent - Clothing Rental Platform",
  "private": true,

  "engines": {
    "node": "20.x"
  },

  "workspaces": [
    "packages/*",
    "apps/web/client",
    "apps/web/admin",
    "server"
  ],

  "scripts": {
    "install-all": "npm install",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=@listnrent/client",
    "dev:admin": "npm run dev --workspace=@listnrent/admin",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=@listnrent/client",
    "build:admin": "npm run build --workspace=@listnrent/admin"
  },

  "devDependencies": {
    "esbuild": "^0.28.0",
    "rollup": "^4.60.3"
  }
}