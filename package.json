{
  "name": "listnrent-monorepo",
  "version": "1.0.0",
  "description": "ListnRent - Clothing Rental Platform",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*",
    "apps/web/client",
    "apps/web/admin",
    "apps/mobile",
    "server"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=@listnrent/client",
    "dev:admin": "npm run dev --workspace=@listnrent/admin",
    "dev:mobile": "npm run start --workspace=@listnrent/mobile",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=@listnrent/client",
    "build:admin": "npm run build --workspace=@listnrent/admin"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "rollup": "^4.60.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "uuid": "11.1.1"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "*",
    "lightningcss-linux-x64-gnu": "*"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11"
  }
}
